<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Menu-bar utility, not an app: no Dock icon, no app switcher entry.
         The runtime also sets ActivationPolicy::Accessory, but doing it here too
         avoids a Dock icon flashing up during launch. -->
    <key>LSUIElement</key>
    <true/>
</dict>
</plist>
